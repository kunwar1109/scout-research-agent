# Free key: https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=

# Free key (1,000 searches/month): https://app.tavily.com
TAVILY_API_KEY=

# Optional: any Gemini model id your key can use
GEMINI_MODEL=gemini-3.1-flash-lite

# Optional: used automatically when GEMINI_MODEL returns 429 (quota) or 503 (overloaded).
# Must be a different model, since each model has its own quota. Default: the other Lite model.
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite

# Optional: Context7 MCP server (library docs). Works without a key at low rate limits;
# a free key raises them: https://context7.com/dashboard?tab=overview&apiKeyAction=create
CONTEXT7_API_KEY=

# Neon Postgres (free): https://console.neon.tech → Connect → copy the pooled connection string.
# Without it, Scout still works but nothing is saved.
DATABASE_URL=
